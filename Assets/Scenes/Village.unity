      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.size
      value: 14
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[0].sentence
      value: "\u0411\u0430\u0433\u0434\u0438\u0444\u0438! \u041C\u0435\u043D\u044F
        \u0437\u043E\u0432\u0443\u0442 \u0410\u0439\u043B\u0438\u043D. \u042F \u0438\u0441\u0441\u043B\u0435\u0434\u0443\u044E
        \u0443\u0434\u044D\u0433\u0435\u0439\u0441\u043A\u0438\u0439 \u044F\u0437\u044B\u043A
        \u0438 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0443. \u042F \u0437\u0434\u0435\u0441\u044C
        \u043F\u043E \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044E
        \u0412\u0430\u0439\u0430\u043D\u043A\u0438. \u041C\u043E\u0433\u0443 \u044F
        \u0437\u0430\u0434\u0430\u0442\u044C \u0432\u0430\u043C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
        \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432?"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[1].sentence
      value: "\u0411\u0430\u0433\u0434\u0438\u0444\u0438, \u043D\u0430\u04C8\u0433\u0438.
        \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u041B\u0430\u0441\u0441\u0430.
        \u041D\u0443, \u0440\u0430\u0437 \u0432\u0430\u0441 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B\u0430
        \u0412\u0430\u0439\u0430\u043D\u043A\u0430, \u0442\u043E\u0433\u0434\u0430
        \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0439\u0442\u0435, \u043D\u043E
        \u043C\u043D\u0435 \u043E\u0441\u043E\u0431\u043E \u043D\u0435\u0447\u0435\u0433\u043E
        \u0432\u0430\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[2].sentence
      value: "\u043D\u0430\u04C8\u0433\u0438?"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[3].sentence
      value: "\u043D\u0430\u04C8\u0433\u0438, \u0442\u043E \u0435\u0441\u0442\u044C
        \u0447\u0443\u0436\u0430\u043A."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[4].sentence
      value: "\u0412\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u0437\u043D\u0430\u0435\u0442\u0435
        \u0443\u0434\u044D\u0433\u0435\u0439\u0441\u043A\u0438\u0439?"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[5].sentence
      value: "\u041D\u0435 \u043E\u0441\u043E\u0431\u043E, \u0442\u043E\u043B\u044C\u043A\u043E
        \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430.
        \u0423\u0434\u044D\u0433\u0435\u0439\u0441\u043A\u0438\u0439 \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C
        \u043F\u043E\u043C\u043D\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0441\u0442\u0430\u0440\u0438\u043A\u0438, \u0434\u0430 \u0448\u0430\u043C\u0430\u043D
        \u043D\u0430\u0448 \u0441 \u0435\u0433\u043E \u0441\u0435\u043C\u044C\u0451\u0439.
        \u0412\u0430\u043C \u0431\u044B \u0441 \u043D\u0438\u043C\u0438 \u043B\u0443\u0447\u0448\u0435
        \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043D\u0430
        \u044D\u0442\u043E\u0442 \u0441\u0447\u0451\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[6].sentence
      value: "\u041A \u043F\u0438\u0441\u044C\u043C\u0443 \u0412\u0430\u0439\u0430\u043D\u043A\u0438
        \u0435\u0449\u0451 \u043F\u0440\u0438\u043B\u0430\u0433\u0430\u043B\u0430\u0441\u044C
        \u0437\u0430\u043F\u0438\u0441\u043A\u0430 \u043D\u0430 \u0443\u0434\u044D\u0433\u0435\u0439\u0441\u043A\u043E\u043C.
        \u041C\u043E\u0436\u0435\u0442 \u0441\u043C\u043E\u0436\u0435\u0442\u0435
        \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u043E \u0447\u0451\u043C
        \u043E\u043D\u0430? \u0425\u043E\u0442\u044F \u0431\u044B \u043E\u0431\u0449\u0438\u0439
        \u0441\u043C\u044B\u0441\u043B."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[7].sentence
      value: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435, \u043D\u043E \u043D\u0435
        \u043E\u0431\u0435\u0449\u0430\u044E, \u0447\u0442\u043E \u0441\u043C\u043E\u0433\u0443
        \u043F\u043E\u043C\u043E\u0447\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[8].sentence
      value: "\xAB\u042D\u0439 \u0445\u043E\u043A\u0442\u043E \u0446\u0443\u043B\u0438\u043D\u0438
        \u0433\u0438\u0430\u043D\u0430\u0435, \u0437\u0443\u0433\u0434\u0438\u0442\u0438\u0442\u0438
        \u044D\u043C\u044D\u0437\u044D\u0443\u044D\u0439\xBB"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[9].sentence
      value: "\u0418\u0437 \u0441\u043B\u043E\u0432 \u0442\u043E\u043B\u044C\u043A\u043E
        \u0444\u0440\u0430\u0437\u0430 \xAB\u042D\u0439 \u0445\u043E\u043A\u0442\u043E
        \u0446\u0443\u043B\u0438\u043D\u0438\xBB \u043A\u0430\u0436\u0435\u0442\u0441\u044F
        \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0439. \u0417\u0434\u0435\u0441\u044C
        \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E \u0434\u043E\u0440\u043E\u0433\u0443
        \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0441\u044F, \u043D\u0435 \u043C\u043E\u0433\u0443
        \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u0447\u043D\u0435\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[10].sentence
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0435!"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[11].sentence
      value: "\u0410 \u0447\u0435\u043C \u0432\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C
        \u0432 \u043E\u0431\u0449\u0438\u043D\u0435?"
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[12].sentence
      value: "\u041F\u043E \u0431\u0435\u0440\u0435\u0441\u0442\u0435 \u0440\u0435\u0436\u0443.
        \u041F\u0440\u0430\u0431\u0430\u0431\u043A\u0430 \u043C\u0435\u043D\u044F
        \u043D\u0430\u0443\u0447\u0438\u043B\u0430. \u0420\u0435\u0437\u044C\u0431\u0430
        \u043D\u0435 \u0441\u0430\u043C\u043E\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u043E\u0435
        \u0437\u0430\u043D\u044F\u0442\u0438\u0435 \u0441\u0440\u0435\u0434\u0438
        \u0436\u0435\u043D\u0449\u0438\u043D, \u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F
        \u0435\u0449\u0451 \u043C\u0430\u0441\u0442\u0435\u0440\u0438\u0446\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 8557568673631317014, guid: a0dbeffc84669e24f994d387893a803d, type: 3}
      propertyPath: sentences.Array.data[13].sentence
      value: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0443\u0434\u0435\u043B\u0438\u043B\u0438
        \u0432\u0440\u0435\u043C\u044F!"
      objectReference: {fileID: 0}
