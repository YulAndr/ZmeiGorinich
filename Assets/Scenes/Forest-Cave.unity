  m_text: "\u0414\u043E\u0440\u043E\u0433\u043E\u0439 \u043D\u0430\u04C8\u0433\u0438,
    \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u043D\u0430 \u044D\u0442\u043E\u043C
    \u043D\u0435 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
    \u0422\u044B \u0443\u0432\u0438\u0434\u0435\u043B \u043B\u0438\u0448\u044C \u0435\u0451
    \u0447\u0430\u0441\u0442\u044C. \n\n\u0414\u0443\u0445\u0430\u043C \u0442\u0430\u0439\u0433\u0438
    \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0441\u0438\u043B \u0438
    \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u0435\u0431\u0435
    \u043E \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u0445
    \u0410\u0439\u043B\u0438\u043D \u0432 \u043C\u0438\u0440\u0435 \u0411\u0443\u043D\u0438\u0433\u044D.
    \n\u0414\u043E \u0441\u043A\u043E\u0440\u043E\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0438!"
